        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PassThrough"
          },
          "400": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "401": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "404": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "413": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "502": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "503": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "504": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "500": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "default": {
            "$ref": "#/components/responses/UpstreamAnswer"
          }
        }
      }
    },
    "/anthropic/v1/models": {
      "get": {
        "tags": [
          "anthropic"
