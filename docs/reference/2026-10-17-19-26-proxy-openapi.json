            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "toggle"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "type"
            ],
            "additionalProperties": false,
            "properties": {
              "type": {
                "type": "string",
                "enum": [
