          },
          "contextWindow": {
            "type": "integer"
          },
          "maxOutputTokens": {
            "type": "integer"
          },
          "createdAt": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "family": {
            "type": "string"
          },
          "releaseDate": {
            "type": "string"
          },
          "knowledge": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "alpha",
              "beta",
              "deprecated"
            ]
          },
          "inputLimit": {
            "type": "integer"
          },
          "input": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Modality"
