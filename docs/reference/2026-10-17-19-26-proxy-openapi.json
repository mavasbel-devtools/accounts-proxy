        "tags": [
          "gemini"
        ],
        "operationId": "geminiCountTokens",
        "summary": "Gemini countTokens: 400 unsupported_feature on every provider (Antigravity has no token-count endpoint; the gateways serve only generateContent and streamGenerateContent).",
        "parameters": [
          {
            "$ref": "#/components/parameters/GeminiModel"
          }
        ],
        "requestBody": {
          "required": true,
