          {
            "name": "anthropic-beta",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "claude: only names of the model's captured beta set (rule F4); gateways: forwarded."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AnthropicMessagesRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/PassThrough"
          },
          "400": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "401": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "404": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "413": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "502": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "503": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "504": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "500": {
            "$ref": "#/components/responses/AnthropicError"
          },
          "default": {
            "$ref": "#/components/responses/UpstreamAnswer"
          }
        }
      }
    },
