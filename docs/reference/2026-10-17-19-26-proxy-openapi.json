      }
    },
    "/gemini/v1beta/models": {
      "get": {
        "tags": [
          "gemini"
        ],
        "operationId": "geminiModels",
        "summary": "Every enabled provider's models in the Gemini ListModels shape.",
        "responses": {
          "200": {
            "description": "The list.",
            "headers": {
              "x-proxy-models-source": {
                "$ref": "#/components/headers/ModelsSource"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GeminiModelList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/GoogleError"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "`Authorization: Bearer <token>` (OpenAI SDK, opencode)."
      },
      "anthropicKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "The Anthropic SDK's carrier."
      },
      "googleKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-goog-api-key",
        "description": "The Google Gen AI SDK's carrier."
      },
      "queryKey": {
        "type": "apiKey",
        "in": "query",
        "name": "key",
        "description": "`?key=<token>`; removed from the query before the request goes upstream."
      }
    },
    "parameters": {
      "Lossy": {
        "name": "x-proxy-lossy",
        "in": "header",
        "required": false,
        "description": "`1`: what the target cannot carry is dropped (and listed in `x-proxy-dropped`) instead of answering 400 unsupported_feature.",
        "schema": {
          "type": "string",
          "enum": [
            "1"
          ]
        }
      },
      "GeminiModel": {
        "name": "model",
        "in": "path",
        "required": true,
        "description": "`<provider>/<model>`, URL-encoded (`antigravity%2Fgemini-3.5-flash-lite`) or raw; the route takes the model up to the last `:`.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "Dropped": {
        "description": "Every feature or element removed from the request, comma-separated: lossy drops and the always-applied wire laws.",
        "schema": {
          "type": "string"
        }
      },
      "ModelsSource": {
        "description": "One `provider=source` pair per enabled provider, comma-separated; source is live, cache, static or unavailable.",
        "schema": {
          "type": "string"
        }
      },
      "RetryAfter": {
        "description": "Seconds to wait, when the provider or the error states it.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "PassThrough": {
        "description": "The provider's own answer: its status, its body (JSON, or the event stream as it arrives) and the response headers listed per provider in the providers reference.",
        "headers": {
          "x-proxy-dropped": {
            "$ref": "#/components/headers/Dropped"
          },
          "retry-after": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {}
          },
          "text/event-stream": {
            "schema": {
              "type": "string"
            }
          }
        }
      },
      "UpstreamAnswer": {
        "description": "Any other status is the provider's own answer, passed through with its body (e.g. 429 with `retry-after`).",
        "headers": {
          "retry-after": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {}
          }
        }
      },
      "PlainError": {
        "description": "A proxy error on the proxy's own routes or outside every dialect prefix.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/PlainError"
            }
          }
        }
      },
      "AnthropicError": {
        "description": "A proxy error in Anthropic's shape.",
        "headers": {
          "retry-after": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/AnthropicError"
            }
          }
        }
      },
      "OpenAIError": {
        "description": "A proxy error in OpenAI's shape.",
        "headers": {
          "retry-after": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/OpenAIError"
            }
          }
        }
      },
      "GoogleError": {
        "description": "A proxy error in Google's shape (an Antigravity error body that already is one is passed verbatim).",
        "headers": {
          "retry-after": {
            "$ref": "#/components/headers/RetryAfter"
          }
        },
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/GoogleError"
            }
          }
        }
      }
    },
    "schemas": {
      "ProviderId": {
        "type": "string",
        "enum": [
          "claude",
          "antigravity",
          "openai",
          "openrouter",
          "opencode",
          "opencode-go",
          "cheaper-inference"
        ]
      },
      "WireFormat": {
        "type": "string",
        "enum": [
          "anthropic-messages",
          "openai-chat",
          "openai-responses",
          "gemini"
        ]
      },
      "Modality": {
        "type": "string",
        "enum": [
          "text",
          "image",
          "audio",
          "video",
          "pdf"
        ]
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "invalid_request",
          "unsupported_feature",
          "unauthorized",
          "unknown_model",
          "unknown_account",
          "not_found",
          "payload_too_large",
          "provider_auth_required",
          "provider_disabled",
          "quota_exhausted",
          "upstream_timeout",
          "upstream_unreachable",
          "upstream_error",
          "internal_error"
        ]
      },
      "Health": {
        "type": "object",
        "required": [
          "status",
          "providers"
        ],
        "additionalProperties": false,
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok"
            ]
          },
          "providers": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ProviderId"
            }
          }
        }
      },
      "OpencodeManifest": {
        "type": "object",
        "required": [
          "auth",
          "remote_config"
        ],
        "additionalProperties": false,
        "properties": {
          "auth": {
            "type": "object",
            "required": [
              "command",
              "env"
            ],
            "additionalProperties": false,
            "properties": {
              "command": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "description": "`env ACCOUNTS_PROXY_HOME=<data> <bun> <entry> token`: prints the proxy token."
              },
              "env": {
                "type": "string",
                "enum": [
                  "ACCOUNTS_PROXY_TOKEN"
                ]
              }
            }
          },
          "remote_config": {
            "type": "object",
            "required": [
              "url",
              "headers"
            ],
            "additionalProperties": false,
            "properties": {
              "url": {
                "type": "string",
                "description": "`http://127.0.0.1:<port>/opencode/config.json`"
              },
              "headers": {
                "type": "object",
                "required": [
                  "authorization"
                ],
                "additionalProperties": false,
                "properties": {
                  "authorization": {
                    "type": "string",
                    "enum": [
                      "Bearer {env:ACCOUNTS_PROXY_TOKEN}"
                    ]
                  }
                }
              }
            }
          }
        }
      },
      "OpencodeConfig": {
        "type": "object",
        "required": [
          "$schema",
          "providers"
        ],
        "description": "opencode v2 configuration (`providers` key, pinned to opencode v2.0.26); the full rules are opencode's published schema.",
        "properties": {
          "$schema": {
            "type": "string"
          },
          "providers": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "required": [
                "name",
                "settings",
                "models"
              ]
            }
          }
        }
      },
      "DetailedModels": {
        "type": "object",
        "required": [
          "catalogs"
        ],
        "additionalProperties": false,
        "properties": {
          "catalogs": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetailedCatalog"
            }
          }
        }
      },
      "DetailedCatalog": {
        "type": "object",
        "required": [
          "provider",
          "source",
          "models"
        ],
        "additionalProperties": false,
        "properties": {
          "provider": {
            "$ref": "#/components/schemas/ProviderId"
          },
          "source": {
            "type": "string",
            "enum": [
              "live",
              "cache",
              "static",
              "unavailable"
            ],
            "description": "Where the provider's list came from: fetched now, the stored copy (24 h), the built-in list, or unavailable (see `error`)."
          },
          "referenceSource": {
            "type": "string",
            "enum": [
              "live",
              "cache",
              "static"
            ],
            "description": "Where the reference catalog (models.opencode.ai) came from; absent for a provider with no reference provider (cheaper-inference)."
          },
          "models": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/DetailedModel"
            }
          },
          "error": {
            "type": "object",
            "required": [
              "code",
              "message"
            ],
            "additionalProperties": false,
            "properties": {
              "code": {
                "$ref": "#/components/schemas/ErrorCode"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "DetailedModel": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "model",
          "name",
          "formats",
          "sources"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
