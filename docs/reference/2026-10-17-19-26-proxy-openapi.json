{
  "openapi": "3.1.0",
  "info": {
    "title": "accounts-proxy",
    "version": "0.1.0",
    "summary": "The local daemon's HTTP API: four request formats in front of seven providers.",
    "description": "Served on http://127.0.0.1:<port> (proxy.yaml `port`, default 4141). Every route except `GET /health` and `GET /.well-known/opencode` needs the proxy token (`bun run proxy token`) in one of the four carriers of the security schemes. A request body that names a model uses `<provider>/<model>` (or an alias from proxy.yaml). The proxy does not translate between formats: a model answers only the formats it accepts natively, any other format is 400 `unsupported_feature`. Pass-through answers (status, body, selected headers) are the provider's own; the proxy's own errors use the error shape of the route's dialect. The prose reference is docs/reference/2026-10-17-19-26-proxy-api.md; `apps/proxy/tests/e2e/docs.test.ts` checks every operation of this document against the real daemon.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:4141",
      "description": "default port; proxy.yaml `port` changes it"
    }
  ],
  "security": [
    {
      "bearer": []
    },
    {
      "anthropicKey": []
    },
    {
      "googleKey": []
    },
    {
      "queryKey": []
    }
  ],
  "tags": [
    {
      "name": "proxy",
      "description": "The proxy's own routes (plain JSON errors)."
    },
    {
      "name": "anthropic",
      "description": "Anthropic Messages dialect, prefix /anthropic (Anthropic error shape)."
    },
    {
      "name": "openai",
      "description": "OpenAI dialect, prefix /openai: Chat Completions and Responses (OpenAI error shape)."
    },
    {
      "name": "gemini",
      "description": "Gemini dialect, prefix /gemini (Google error shape)."
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "proxy"
        ],
        "operationId": "health",
        "summary": "Liveness and the enabled providers.",
        "security": [],
        "responses": {
          "200": {
            "description": "The daemon answers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/.well-known/opencode": {
      "get": {
        "tags": [
          "proxy"
        ],
        "operationId": "opencodeWellKnown",
        "summary": "The manifest `opencode auth login http://127.0.0.1:<port>` reads (decision E1, rule O5). It carries no secret: the command that prints the token and the configuration URL.",
        "security": [],
        "responses": {
          "200": {
            "description": "The manifest.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpencodeManifest"
                }
              }
            }
          }
        }
      }
    },
    "/opencode/config.json": {
      "get": {
        "tags": [
          "proxy"
        ],
        "operationId": "opencodeConfig",
        "summary": "The opencode v2 configuration of every model of every enabled provider: one provider `ap-<provider>` each (rules O1–O6).",
        "responses": {
          "200": {
            "description": "An opencode v2 configuration document; it validates against opencode's published schema (docs/reference/specs/opencode-config-schema.json, https://opencode.ai/config.json).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OpencodeConfig"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/PlainError"
          }
        }
      }
    },
    "/proxy/v1/models": {
      "get": {
        "tags": [
          "proxy"
        ],
        "operationId": "detailedModels",
        "summary": "Every enabled provider's models in detail, each field with its source (rules M1–M6).",
        "parameters": [
          {
            "name": "provider",
            "in": "query",
            "required": false,
            "description": "Only this provider.",
            "schema": {
              "$ref": "#/components/schemas/ProviderId"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One catalog per provider.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DetailedModels"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/PlainError"
          },
          "401": {
            "$ref": "#/components/responses/PlainError"
          }
        }
      }
    },
