          "temperature": {
            "type": "boolean"
          },
          "reasoning": {
            "type": "boolean"
          },
          "reasoningOptions": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReasoningOption"
            }
          },
          "interleavedField": {
            "type": "string"
          },
          "openWeights": {
            "type": "boolean"
          },
          "aiSdkPackage": {
            "type": "string"
          },
          "cost": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ModelCost"
            },
            "description": "USD per million tokens; the first entry is the base price, later entries context tiers."
          },
          "sources": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Per stated field: `provider:<id>` or `models.opencode.ai:<reference provider>/<model>` (rule M3)."
          }
        }
